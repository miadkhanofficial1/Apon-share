{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Apon",
  "version": "1.0.0",
  "identifier": "com.mkstudio.apon",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Apon",
        "width": 420,
        "height": 650,
        "minWidth": 360,
        "minHeight": 540,
        "resizable": true,
        "fullscreen": false,
        "decorations": true,
        "transparent": false,
        "shadow": true
      }
    ],
    "security": {
      "csp": null
    },
    "trayIcon": {
      "iconPath": "icons/32x32.png",
      "tooltip": "Apon - Instant. Private. Yours."
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "copyright": "© 2026 Apon by MK.Studio. All rights reserved.",
    "category": "Utility",
    "shortDescription": "Instant. Private. Yours. Cross-platform local P2P file sharing.",
    "longDescription": "Apon connects devices directly over local Wi-Fi or Wi-Fi Direct with zero internet and zero cloud storage.",
    "macOS": {
      "entitlements": "Entitlements.plist"
    }
  }
}
